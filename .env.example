# Copy to .env (gitignored) and fill in. Loaded in development/test by dotenv-rails.
# Create a key with: bin/rails "keys:create[finance,dev]"
# The dev console served at / uses this key so you don't have to paste it.
FINANCE_API_KEY=

# Optional: your UP personal access token (https://api.up.com.au), used by the console's pull tab.
# It is sent to this app per request and is never stored or logged by the server.
UP_API_TOKEN=
