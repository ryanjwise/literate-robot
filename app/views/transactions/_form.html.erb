<%= form_with(model: transaction) do |form| %>
  <% if transaction.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>

      <ul>
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :dollars, style: "display: block" %>
    <%= form.number_field :dollars %>
  </div>

  <div>
    <%= form.label :cents, style: "display: block" %>
    <%= form.number_field :cents %>
  </div>

  <div>
  <%= form.label :expense, style: "display: block" %>
  <%= form.collection_select :expense_id, Expense.order(:name), :id, :name %>
</div>
  
  <div>
    <%= form.label :source, style: "display: block" %>
    <%= form.text_field :source %>
  </div>

  <div>
    <%= form.label :notes, style: "display: block" %>
    <%= form.text_area :notes %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
