<div id="<%= dom_id transaction %>">
  <p>
    <strong>Date:</strong>
    <%= transaction.date %>
  </p>

  <p>
    <strong>Dollars:</strong>
    <%= transaction.dollars %>
  </p>

  <p>
    <strong>Cents:</strong>
    <%= transaction.cents %>
  </p>

  <p>
    <strong>Source:</strong>
    <%= transaction.source %>
  </p>

  <p>
    <strong>Notes:</strong>
    <%= transaction.notes %>
  </p>

</div>
