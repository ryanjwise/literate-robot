<div id="<%= dom_id expense %>">
  <p>
    <strong>Name:</strong>
    <%= expense.name %>
  </p>

  <p>
    <strong>Frequency:</strong>
    <%= expense.frequency %>
  </p>

  <p>
    <strong>Expense Category:</strong>
    <%= expense.expense_category.name %>
  </p>

  <p>
    <strong># Transactions:</strong>
    <%= expense.transactions.count %>
  </p>

</div>
